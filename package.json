{
  "name": "lootdrop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run db:generate --workspace=@lootdrop/api",
    "dev:api": "npm run build --workspace=@lootdrop/contracts && npm run dev --workspace=@lootdrop/api",
    "dev:web": "npm run build --workspace=@lootdrop/contracts && npm run dev --workspace=@lootdrop/web",
    "enrich:once": "npm run enrich:once --workspace=@lootdrop/api --",
    "start": "npm run start --workspace=@lootdrop/api",
    "start:worker": "npm run start:worker --workspace=@lootdrop/api",
    "test:e2e": "npm run build --workspace=@lootdrop/contracts && playwright test --project=mocked",
    "test:e2e:smoke": "npm run build --workspace=@lootdrop/contracts && node scripts/phase6-test-guard.mjs -- node node_modules/@playwright/test/cli.js test --project=smoke",
    "screenshots": "npm run build --workspace=@lootdrop/contracts && playwright test --project=screenshots",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace=@lootdrop/contracts && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
